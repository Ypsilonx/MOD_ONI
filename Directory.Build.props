<Project>
  <!-- Společné nastavení všech modů v mods/*. Cesty uprav tady, když se hra nebo složka modů přesune. -->
  <PropertyGroup>
    <GameDir><Steam>\steamapps\common\OxygenNotIncluded</GameDir>
    <ManagedDir>$(GameDir)\OxygenNotIncluded_Data\Managed</ManagedDir>
    <!-- Skutečná složka modů hry v OneDrive (junction OneDrive nesynchronizoval, viz CLAUDE.md). -->
    <ModsDir>%USERPROFILE%\OneDrive\Dokumenty\Klei\OxygenNotIncluded\mods</ModsDir>

    <!-- Hra běží na Unity 6 (Mono s API .NET Framework 4.8). -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
