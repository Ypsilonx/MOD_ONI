<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build nástroj (ne mod): odstraní z DLL typy, které závisí na assembly chybějících ve hře.
    Directory.Build.* z kořene repa se sem nesmí propsat (net48, reference na hru), proto vlastní hodnoty.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>bin\</OutputPath>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsModTool>true</IsModTool>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
